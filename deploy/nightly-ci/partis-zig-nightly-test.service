[Unit]
Description=partis zig-core nightly Debug GPA leak check
Documentation=https://github.com/psathyrella/partis/issues/405
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Inherit a login-like PATH so zig (installed under ~/local/bin) and curl
# are found. The service assumes the cron-owned clone lives at
# ~/re/pz-zig-nightly-ci; override via the PARTIS_ZIG_NIGHTLY_* environment
# variables (see scripts/nightly_zig_debug_test.sh) if the layout differs.
Environment=PATH=%h/.pixi/bin:%h/local/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/re/pz-zig-nightly-ci/scripts/nightly_zig_debug_test.sh
# Measured wall time for the full run on a clean main: ~21s for the
# partis-test.py tier (issue #405) plus a `zig build test` and a
# `zig build -Doptimize=Debug` (each well under a minute on pax). 15 minutes
# gives ample headroom before systemd treats an invocation as hung; revisit
# if the measured trend in the ci/nightly-ci README creeps upward.
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
