[Unit]
Description=Run the partis zig-core nightly Debug GPA leak check at 03:15 local
Documentation=https://github.com/psathyrella/partis/issues/405

[Timer]
# 03:15 local time -- 45 minutes after phyz's own nightly (02:30, see
# ~/re/phyz/deploy/nightly-ci/phyz-nightly-test.timer) so the two don't
# contend for the same box at the same instant. Randomize by up to 15
# minutes on top of that for the same reason phyz's timer does.
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=15min
# Catch up after the machine has been suspended or powered off overnight.
Persistent=true
Unit=partis-zig-nightly-test.service

[Install]
WantedBy=timers.target
